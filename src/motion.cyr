# motion.cyr — the SYSTEM MOTION VOCABULARY: named motion roles the desktop grants and apps inherit.
#
# ⭐⭐ THE RULING THIS IMPLEMENTS (operator, 2026-08-17): *"compositor grants the motion, apps can
# override per-widget, but lets guard against any impossible or highly destructive behaviors."*
# So: one vocabulary defined here, resolved per-widget by the consumer, and **every override passes
# through a clamp** — an app may choose within the envelope, never outside it.
#
# ⚠ IT LIVES IN rupa FOR THE SAME REASON THE COLOUR TOKENS DO. The compositor's chrome and the dhancha
# toolkit and the apps must move as ONE system; a vocabulary owned by the compositor could not be read
# by a client-side toolkit (a toolkit cannot depend on the compositor), and one owned by dhancha would
# leave the compositor's own chrome inventing its own. rupa is the shared core both already read.
#
# ⛔ THIS FILE DOES NOT ANIMATE ANYTHING. It defines roles, resolves overrides, and answers "how far
# through is this, at time t" as pure arithmetic. Drawing belongs to whoever owns pixels. That split is
# what makes every guard below testable on a host with no screen and no clock.

# ============================================================================================
# THE ROLES — what the system grants
# ============================================================================================
# ⚠ ROLES, NOT DURATIONS. An app asking for "220 ms ease-out" has hardcoded a look; an app asking for
# QUICK inherits whatever the desktop decides QUICK means, and moves with everything else when that
# changes. This is exactly why the colour tokens are named `accent`/`alert` and not hex.
enum RupaMotion {
    RU_MO_INSTANT = 0;   # state changes with no travel — a checkbox, a focus ring
    RU_MO_QUICK   = 1;   # small, local acknowledgement — hover, press
    RU_MO_CALM    = 2;   # a panel opening, a window settling
    RU_MO_BUSY    = 3;   # ⭐ THE "system is working" role — periodic, and the one apps may not silence
    RU_MO_COUNT   = 4;
}

enum RupaEase {
    RU_EASE_LINEAR = 0;
    RU_EASE_OUT    = 1;   # decelerate — the default for anything arriving
    RU_EASE_IN_OUT = 2;   # symmetric — the default for anything periodic
}

# ============================================================================================
# ⛔⛔ THE GUARD ENVELOPE — the "impossible or highly destructive" bounds
# ============================================================================================
# ⚠ THE FLASH BAND IS THE ONE THAT MATTERS AND IT IS NOT A STYLE RULE. Periodic visual change between
# roughly **3 Hz and 55 Hz** is the photosensitive-epilepsy trigger band; content flashing in it can
# cause seizures. A widget that "pulses to show it is busy" at 10 Hz is inside it. ⇒ Any periodic role
# is floored at a period of `RU_MO_PERIOD_MIN_MS`, which puts its cycle at or below 3 Hz, and NO
# override can go under it. This is the single hardest limit in the file and the reason the clamp is
# not advisory.
# ⚠ A ZERO DURATION IS NOT "FAST", IT IS ABSENT. A press with no acknowledgement reads as a dead
# control — the same "responds to nothing" failure as a painted-but-inert button. Floored, not allowed.
# ⚠ AND A VERY LONG ONE READS AS HUNG. A 6-second window settle is indistinguishable from a stall, so
# the ceiling is a correctness bound on the operator's belief about the machine, not on taste.
var RU_MO_DUR_MIN_MS    = 60;      # under this, motion is not perceived — it reads as no feedback
var RU_MO_DUR_MAX_MS    = 1200;    # over this, motion reads as the machine being stuck
var RU_MO_PERIOD_MIN_MS = 340;     # ~2.94 Hz — BELOW the 3 Hz photosensitive floor. Never lower this.
var RU_MO_PERIOD_MAX_MS = 4000;    # a "working" pulse slower than this stops reading as activity

# ⭐⭐ REDUCED MOTION — the accessibility switch, and it OUTRANKS every app.
# ⛔ An app override cannot re-enable motion the system has turned off. That inversion is the whole
# point: a per-widget override is a choice WITHIN the envelope, and "the operator cannot tolerate
# motion" is the envelope. Vestibular disorders make this a harm question, not a preference one.
# ⚠ Reduced does NOT mean frozen: BUSY still reports progress, because silently removing the only
# indication that the system is working is its own failure. It collapses to a non-periodic, minimal
# form — see `rupa_motion_duration`.
var ru_motion_reduced = 0;
fn rupa_motion_reduced(): i64 { return ru_motion_reduced; }
fn rupa_motion_set_reduced(v): i64 {
    if (v != 0) { ru_motion_reduced = 1; } else { ru_motion_reduced = 0; }
    return ru_motion_reduced;
}

# ============================================================================================
# THE GRANTED VALUES
# ============================================================================================
fn rupa_motion_is_periodic(role): i64 {
    if (role == RupaMotion.RU_MO_BUSY) { return 1; }
    return 0;
}

fn rupa_motion_default_ease(role): i64 {
    if (role == RupaMotion.RU_MO_INSTANT) { return RupaEase.RU_EASE_LINEAR; }
    if (role == RupaMotion.RU_MO_BUSY)    { return RupaEase.RU_EASE_IN_OUT; }
    return RupaEase.RU_EASE_OUT;
}

# The system's granted duration for a role, in ms. INSTANT is genuinely 0 — it is a state change, not a
# travel — and is the one role exempt from the duration floor, because there is nothing to perceive.
fn rupa_motion_grant_ms(role): i64 {
    if (role == RupaMotion.RU_MO_INSTANT) { return 0; }
    if (role == RupaMotion.RU_MO_QUICK)   { return 120; }
    if (role == RupaMotion.RU_MO_CALM)    { return 260; }
    if (role == RupaMotion.RU_MO_BUSY)    { return 900; }   # one pulse period
    return 0;
}

# ============================================================================================
# ⭐⭐ THE CLAMP — every override goes through here, and it is the whole safety story
# ============================================================================================
# `want_ms` is what an app asked for; 0 or negative means "no override, use the grant".
# -> the duration the consumer must actually use.
#
# ⛔ ORDER IS LOAD-BEARING: reduced-motion is applied LAST, so it cannot be defeated by an override
# that happens to land inside the envelope. Clamping first and then checking reduced would let an app
# that asks for 900 ms get 900 ms on a machine that asked for stillness.
fn rupa_motion_duration(role, want_ms): i64 {
    if (role < 0) { return 0; }
    if (role >= RupaMotion.RU_MO_COUNT) { return 0; }
    var d = rupa_motion_grant_ms(role);
    if (want_ms > 0) { d = want_ms; }
    # INSTANT has no travel to floor; every other role does.
    if (role != RupaMotion.RU_MO_INSTANT) {
        if (rupa_motion_is_periodic(role) == 1) {
            if (d < RU_MO_PERIOD_MIN_MS) { d = RU_MO_PERIOD_MIN_MS; }
            if (d > RU_MO_PERIOD_MAX_MS) { d = RU_MO_PERIOD_MAX_MS; }
        } else {
            if (d < RU_MO_DUR_MIN_MS) { d = RU_MO_DUR_MIN_MS; }
            if (d > RU_MO_DUR_MAX_MS) { d = RU_MO_DUR_MAX_MS; }
        }
    }
    # ⛔ REDUCED MOTION, APPLIED AFTER THE CLAMP AND OUTRANKING THE APP.
    # ⚠ BUSY is NOT silenced — it keeps a slow, non-flashing period, because an app or a desktop that
    # removes the only sign the system is working has replaced motion with a lie about system state.
    if (ru_motion_reduced == 1) {
        if (rupa_motion_is_periodic(role) == 1) { return RU_MO_PERIOD_MAX_MS; }
        return 0;
    }
    return d;
}

# The easing a consumer must use. `want_ease` < 0 means "no override".
# ⚠ An unknown easing id is REFUSED back to the grant rather than clamped into a neighbour: a caller
# passing garbage should get the system's answer, not a silently different curve.
fn rupa_motion_ease(role, want_ease): i64 {
    if (ru_motion_reduced == 1) { return RupaEase.RU_EASE_LINEAR; }
    if (want_ease < 0) { return rupa_motion_default_ease(role); }
    if (want_ease > RupaEase.RU_EASE_IN_OUT) { return rupa_motion_default_ease(role); }
    return want_ease;
}

# ============================================================================================
# PROGRESS — pure arithmetic, so a consumer needs no clock of its own to be tested
# ============================================================================================
# -> 0..255, the eased position at `elapsed_ms` through a `dur_ms` motion.
# ⚠ 0..255 rather than a float: this stack is integer-first, the value feeds colour and geometry
# interpolation that is already 8-bit, and a fixed range makes the endpoints exactly representable.
# ⛔ A ZERO OR NEGATIVE DURATION ANSWERS 255 (finished), never divides. An animation that never
# completes is the "impossible behaviour" a caller would otherwise construct by accident, and a
# divide-by-zero is how it would present.
fn rupa_motion_progress(dur_ms, elapsed_ms, ease): i64 {
    if (dur_ms <= 0) { return 255; }
    if (elapsed_ms <= 0) { return 0; }
    if (elapsed_ms >= dur_ms) { return 255; }
    var t = (elapsed_ms * 255) / dur_ms;          # linear 0..255
    if (ease == RupaEase.RU_EASE_LINEAR) { return t; }
    if (ease == RupaEase.RU_EASE_OUT) {
        # 1-(1-t)^2, in 0..255 fixed point: decelerating arrival.
        var inv = 255 - t;
        return 255 - ((inv * inv) / 255);
    }
    # IN_OUT — symmetric ease, the periodic default.
    if (t < 128) { return (2 * t * t) / 255; }
    var u = 255 - t;
    return 255 - ((2 * u * u) / 255);
}

# Position within a repeating cycle. -> 0..255, rising then falling, so a pulse returns to where it
# started and never jumps.
# ⛔ THE PERIOD IS RE-FLOORED HERE, not trusted. A caller can reach this without going through
# `rupa_motion_duration`, and the flash band must not depend on which door was used.
fn rupa_motion_cycle(period_ms, elapsed_ms, ease): i64 {
    var p = period_ms;
    if (p < RU_MO_PERIOD_MIN_MS) { p = RU_MO_PERIOD_MIN_MS; }
    var e = elapsed_ms;
    if (e < 0) { e = 0; }
    var phase = e % p;
    var half = p / 2;
    if (half <= 0) { return 0; }
    if (phase < half) { return rupa_motion_progress(half, phase, ease); }
    return 255 - rupa_motion_progress(half, phase - half, ease);
}
